[Unit]
Description=Jam Sholat Masjid - Kiosk Display (cage + Chromium)
After=network-online.target apache2.service systemd-user-sessions.service
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
Type=simple
User=jamsholat
Group=jamsholat
# Sesi login di tty1 lewat PAM/logind supaya cage boleh memakai layar & input.
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
# Kursor transparan (dipasang install.sh/update.sh): cage selalu menggambar kursor
# di tengah layar walau tidak ada mouse, dan selalu memuat tema bernama "default"
# (XCURSOR_THEME diabaikan). Jadi folder pencarian kursor diarahkan ke tema
# "default" milik kita sendiri yang isinya transparan.
Environment=XCURSOR_PATH=/usr/share/jamsholat/cursors
Environment=XCURSOR_SIZE=24
ExecStart=/usr/bin/cage -d -- /opt/jamsholat/scripts/kiosk_browser.sh
Restart=always
RestartSec=5

[Install]
# Raspberry Pi OS Lite boot ke multi-user.target (tanpa display manager),
# jadi graphical.target tidak pernah tercapai dan kiosk tidak akan start.
WantedBy=multi-user.target
