[Unit]
Description=Jam Sholat Masjid - Kiosk Display (X + Openbox + Chromium)
After=network-online.target apache2.service systemd-user-sessions.service
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
Type=simple
User=jamsholat
Group=jamsholat
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
# Trik standar untuk menjalankan X session dari systemd tanpa display manager:
ExecStart=/usr/bin/startx /opt/jamsholat/scripts/kiosk_xsession.sh -- :0 vt1 -nolisten tcp
Restart=on-failure
RestartSec=5

[Install]
# Raspberry Pi OS Lite boot ke multi-user.target (tanpa display manager),
# jadi graphical.target tidak pernah tercapai dan kiosk tidak akan start.
WantedBy=multi-user.target
