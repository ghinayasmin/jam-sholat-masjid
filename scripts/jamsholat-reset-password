#!/bin/bash
#
# jamsholat-reset-password: kembalikan akun panel takmir ke admin / 000 (REQ-F-072, #41).
# Dipasang ke /usr/local/sbin oleh install.sh dan update.sh, jadi bisa dijalankan
# dari folder mana pun:
#
#   sudo jamsholat-reset-password
#
set -euo pipefail
INSTALL_DIR="/opt/jamsholat"
SERVICE_USER="jamsholat"

if [ "$(id -u)" -ne 0 ]; then
    echo "Jalankan dengan sudo: sudo jamsholat-reset-password" >&2
    exit 1
fi
# Dijalankan sebagai user layanan supaya izin file database tetap benar.
exec runuser -u "$SERVICE_USER" -- php "$INSTALL_DIR/scripts/reset_password_cli.php" "$@"
