#!/bin/bash
# prerm — hentikan layanan sebelum paket dilepas atau diperbarui.
set -e
if [ -d /run/systemd/system ] && { [ "$1" = "remove" ] || [ "$1" = "upgrade" ]; }; then
    systemctl stop jamsholat-alarm.service jamsholat-camera.service jamsholat-retention.timer > /dev/null 2>&1 || true
fi
if [ "$1" = "remove" ] && [ -d /run/systemd/system ]; then
    systemctl disable jamsholat-alarm.service jamsholat-camera.service jamsholat-retention.timer > /dev/null 2>&1 || true
fi
exit 0
