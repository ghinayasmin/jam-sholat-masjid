#!/bin/bash
#
# jamsholat-session: dijalankan saat pengguna masuk ke desktop (XDG autostart,
# /etc/xdg/autostart/jamsholat-session.desktop) pada instalasi dari paket .deb.
#
# Di komputer berdesktop, suara hanya bisa keluar lewat sesi pengguna
# (PulseAudio/PipeWire), jadi layanan alarm, kamera, dan layar kiosk berjalan di
# sini, bukan sebagai layanan sistem (DECISIONS.md #39). Di server tanpa desktop,
# postinst menyalakan layanan systemd biasa dan skrip ini tidak melakukan apa-apa.
#
set -u
INSTALL_DIR="/opt/jamsholat"
MODE_FILE="/etc/jamsholat/mode"
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/jamsholat"
URL="http://localhost/display.php?layar=desktop"   # desktop: petunjuk Alt+F4

[ "$(cat "$MODE_FILE" 2>/dev/null)" = "desktop" ] || exit 0
mkdir -p "$LOG_DIR"

# Satu sesi per pengguna, supaya suara adzan tidak dobel. Menu "Layar Jamaah"
# menjalankan skrip ini juga; bila sesi sudah berjalan, skrip ini hanya membuka
# layar (lihat bagian akhir).
exec 9> "${XDG_RUNTIME_DIR:-/tmp}/jamsholat-session-$(id -u).lock"
flock -n 9 && FIRST=1 || FIRST=0

export JAMSHOLAT_DB_PATH="$INSTALL_DIR/storage/jamsholat.db"
export JAMSHOLAT_AUDIO_PATH="$INSTALL_DIR/public/assets/audio"
export JAMSHOLAT_CAPTURES_PATH="$INSTALL_DIR/storage/captures"
export JAMSHOLAT_PHP_BIN="/usr/bin/php"
export JAMSHOLAT_MPG123_OUTPUT=""   # keluaran bawaan sesi (PulseAudio/PipeWire)

# Jalankan ulang bila berhenti (mis. kamera dicabut), seperti Restart= di systemd.
keep_running() {
    local name="$1"; shift
    while true; do
        "$@" >> "$LOG_DIR/$name.log" 2>&1
        sleep 10
    done
}

# postinst memberi akun desktop izin tulis (ACL) ke folder data. Akun yang dibuat
# setelah instalasi belum punya izin itu: beri tahu, jangan diam saja.
if [ "$FIRST" = 1 ] && ! { [ -w "$JAMSHOLAT_DB_PATH" ] && [ -w "$INSTALL_DIR/storage" ]; }; then
    notify-send "Jam Sholat Masjid" "Akun ini belum diizinkan menulis data. Jalankan: sudo dpkg-reconfigure jamsholat" 2>/dev/null || true
fi

# Profil browser sendiri ("jamsholat-kiosk"): mode kiosk tetap berlaku walau browser
# biasa sedang terbuka, dan prosesnya bisa dikenali untuk kiosk_open. Browser snap
# (Ubuntu) tidak boleh menulis folder tersembunyi di home, jadi profilnya di ~/snap.
profile_dir() {
    local snap="$1" name="$2"
    if [ -n "$snap" ] && [ -x "/snap/bin/$snap" ]; then
        echo "$HOME/snap/$snap/common/$name"
    else
        echo "$HOME/.config/$name"
    fi
}

kiosk_open() {
    pgrep -u "$(id -u)" -f -- "jamsholat-kiosk" > /dev/null
}

open_kiosk() {
    local browser profile
    for browser in chromium chromium-browser google-chrome firefox-esr firefox; do
        command -v "$browser" > /dev/null || continue
        case "$browser" in
            firefox*)
                profile="$(profile_dir "$browser" jamsholat-kiosk-firefox)"
                mkdir -p "$profile"
                # Profil baru: lewati halaman sambutan & pemulihan sesi.
                cat > "$profile/user.js" << 'PREFS'
user_pref("browser.aboutwelcome.enabled", false);
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.startup.homepage_override.mstone", "ignore");
user_pref("browser.sessionstore.resume_from_crash", false);
user_pref("datareporting.policy.dataSubmissionPolicyBypassNotification", true);
user_pref("toolkit.telemetry.reportingpolicy.firstRun", false);
PREFS
                "$browser" --new-instance --profile "$profile" --kiosk "$URL" >> "$LOG_DIR/kiosk.log" 2>&1 9>&- & ;;
            *)
                case "$browser" in chromium*) profile="$(profile_dir chromium jamsholat-kiosk)" ;;
                                   *) profile="$(profile_dir "" jamsholat-kiosk)" ;; esac
                "$browser" --kiosk --noerrdialogs --disable-infobars --no-first-run \
                    --disable-session-crashed-bubble --password-store=basic \
                    --user-data-dir="$profile" "$URL" >> "$LOG_DIR/kiosk.log" 2>&1 9>&- & ;;
        esac
        return
    done
    echo "$(date '+%F %T') tidak ada browser (chromium/firefox)" >> "$LOG_DIR/kiosk.log"
}

if [ "$FIRST" = 0 ]; then
    # Menu "Layar Jamaah" diklik saat sesi sudah berjalan. Layar yang masih terbuka
    # (mungkin tertutup jendela lain) ditutup lalu dibuka lagi dari proses ini: proses
    # yang baru diklik pengguna boleh tampil di depan, juga di Wayland.
    if kiosk_open; then
        pkill -u "$(id -u)" -f -- "jamsholat-kiosk"
        for _ in $(seq 1 20); do kiosk_open || break; sleep 0.5; done
    fi
    open_kiosk
    exit 0
fi

keep_running alarm /usr/bin/python3 "$INSTALL_DIR/alarm_service/alarm_service.py" 9>&- &
if [ -e /dev/video0 ] && python3 -c "import cv2" 2>/dev/null; then
    keep_running camera /usr/bin/python3 "$INSTALL_DIR/camera_service/motion_detect.py" 9>&- &
fi

# Tunggu Apache siap, lalu buka layar jamaah layar penuh.
for _ in $(seq 1 30); do
    curl -fs -o /dev/null "$URL" && break
    sleep 2
done
kiosk_open || open_kiosk   # mungkin sudah dibuka lewat menu selama menunggu
wait
